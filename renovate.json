{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>major/renovate-config"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track OpenCode, gh, glab, mcp-atlassian, and oh-my-opencode-slim versions pinned as Containerfile ARGs",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG [A-Z][A-Z0-9_]*_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Keep OpenCode on the V2 line",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@opencode/cli"],
      "allowedVersions": "<3.0.0"
    }
  ]
}
